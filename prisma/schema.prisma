generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MatchStatus {
  DRAFT
  OPEN
  CLOSED
  SETTLED
  CANCELLED
}

enum RoundType {
  GROUP
  ROUND_OF_32
  ROUND_OF_16
  QUARTER_FINAL
  SEMI_FINAL
  THIRD_PLACE
  FINAL
}

enum TeamSide {
  TEAM_A
  TEAM_B
}

enum VoteChoice {
  TEAM_A
  DRAW
  TEAM_B
}

enum LossTransactionType {
  LOSS
  REVERSAL
}

enum ShopItemType {
  AVATAR_FRAME
  AVATAR_WINGS
  AVATAR_AURA
  TITLE
  NAMEPLATE
}

enum ShopItemRarity {
  COMMON
  RARE
  EPIC
  MYTHIC
  LEGENDARY
}

enum CtomTransactionType {
  PURCHASE
  REFUND
  GRANT
}

enum MatchDecisionMethod {
  REGULAR
  EXTRA_TIME
  PENALTY_SHOOTOUT
}

enum SideMarketType {
  CHAMPION
  TOP_SCORER
}

enum SideMarketPickPhase {
  CHAMPION
  QUARTER_FINAL
  SEMI_FINAL
}

enum SideMarketPickOutcome {
  PENDING
  WON
  LOST
}

enum MiniBetType {
  TOTAL_GOALS
  FIRST_GOAL
  KICKOFF
  PENALTY_90
  CORNERS_8
  PLAYER_GOAL
}

enum MiniBetChoice {
  OVER
  UNDER
  TEAM_A
  TEAM_B
  YES
  NO
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  emailVerified      Boolean   @default(false)
  image              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  username           String?   @unique
  displayUsername    String?
  role               String    @default("user")
  banned             Boolean   @default(false)
  banReason          String?
  banExpires         DateTime?
  department         String    @default("")
  mustChangePassword Boolean   @default(false)
  autoFollowUserId   String?

  sessions          Session[]
  accounts          Account[]
  votes             Vote[]
  lossTransactions  LossTransaction[]
  payments          Payment[]           @relation("PaymentOwner")
  confirmedPayments Payment[]           @relation("PaymentConfirmer")
  voidedPayments    Payment[]           @relation("PaymentVoider")
  settledResults    MatchResult[]       @relation("ResultSettler")
  resultRevisions   ResultRevision[]    @relation("RevisionCreator")
  auditLogs         AuditLog[]          @relation("AuditActor")
  autoFollowUser    User?               @relation("UserAutoFollow", fields: [autoFollowUserId], references: [id], onDelete: SetNull)
  autoFollowers     User[]              @relation("UserAutoFollow")
  shopInventory     UserShopItem[]
  equippedCosmetics UserCosmeticEquip[]
  ctomTransactions  CtomTransaction[]
  sideMarketPicks   SideMarketPick[]
  miniBetPicks      MiniBetPick[]
  miniBetResults    MiniBetResult[]     @relation("MiniBetResultSettler")

  @@index([autoFollowUserId])
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Match {
  id                 String      @id @default(cuid())
  teamA              String
  teamB              String
  teamACode          String?
  teamBCode          String?
  teamACrest         String?
  teamBCrest         String?
  kickoffAt          DateTime    @db.Timestamptz(3)
  round              RoundType
  contributionAmount Int
  handicap           Float
  handicappedTeam    TeamSide?
  status             MatchStatus @default(DRAFT)
  externalSource     String?
  externalFixtureId  String?
  lastSyncedAt       DateTime?   @db.Timestamptz(3)
  deletedAt          DateTime?   @db.Timestamptz(3)
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(3)

  votes            Vote[]
  result           MatchResult?
  resultRevisions  ResultRevision[]
  lossTransactions LossTransaction[]
  miniBetPicks     MiniBetPick[]
  miniBetResults   MiniBetResult[]

  @@unique([externalSource, externalFixtureId])
  @@index([status, kickoffAt])
}

model Vote {
  id        String     @id @default(cuid())
  userId    String
  matchId   String
  choice    VoteChoice
  hopeStar  Boolean    @default(false)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  match Match @relation(fields: [matchId], references: [id], onDelete: Restrict)

  @@unique([userId, matchId])
  @@index([matchId, choice])
}

model MatchResult {
  id              String              @id @default(cuid())
  matchId         String              @unique
  teamAScore      Int
  teamBScore      Int
  winningChoice   VoteChoice
  decisionMethod  MatchDecisionMethod @default(REGULAR)
  teamAFinalScore Int
  teamBFinalScore Int
  advancedTeam    TeamSide?
  revision        Int
  settledAt       DateTime            @default(now()) @db.Timestamptz(3)
  settledById     String

  match     Match @relation(fields: [matchId], references: [id], onDelete: Restrict)
  settledBy User  @relation("ResultSettler", fields: [settledById], references: [id], onDelete: Restrict)
}

model ResultRevision {
  id              String              @id @default(cuid())
  matchId         String
  revision        Int
  teamAScore      Int
  teamBScore      Int
  winningChoice   VoteChoice
  decisionMethod  MatchDecisionMethod @default(REGULAR)
  teamAFinalScore Int
  teamBFinalScore Int
  advancedTeam    TeamSide?
  createdById     String
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)

  match     Match @relation(fields: [matchId], references: [id], onDelete: Restrict)
  createdBy User  @relation("RevisionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([matchId, revision])
}

model LossTransaction {
  id                 String              @id @default(cuid())
  userId             String
  matchId            String?
  sideMarketPickId   String?
  miniBetPickId      String?
  amount             Int
  type               LossTransactionType
  settlementRevision Int
  note               String?
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)

  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  match          Match?          @relation(fields: [matchId], references: [id], onDelete: Restrict)
  sideMarketPick SideMarketPick? @relation(fields: [sideMarketPickId], references: [id], onDelete: Restrict)
  miniBetPick    MiniBetPick?    @relation(fields: [miniBetPickId], references: [id], onDelete: Restrict)

  @@unique([userId, matchId, settlementRevision, type])
  @@unique([userId, sideMarketPickId, settlementRevision, type])
  @@unique([userId, miniBetPickId, settlementRevision, type])
  @@index([userId])
  @@index([sideMarketPickId])
  @@index([miniBetPickId])
}

model MiniBetPick {
  id        String        @id @default(cuid())
  userId    String
  matchId   String
  type      MiniBetType
  choice    MiniBetChoice
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)

  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  match            Match             @relation(fields: [matchId], references: [id], onDelete: Restrict)
  lossTransactions LossTransaction[]

  @@unique([userId, matchId, type])
  @@index([matchId, type])
  @@index([userId])
}

model MiniBetResult {
  id            String         @id @default(cuid())
  matchId       String
  type          MiniBetType
  winningChoice MiniBetChoice?
  voided        Boolean        @default(false)
  revision      Int
  settledAt     DateTime       @default(now()) @db.Timestamptz(3)
  settledById   String

  match     Match @relation(fields: [matchId], references: [id], onDelete: Restrict)
  settledBy User  @relation("MiniBetResultSettler", fields: [settledById], references: [id], onDelete: Restrict)

  @@unique([matchId, type])
  @@index([matchId])
  @@index([settledById])
}

model SideMarket {
  id          String         @id @default(cuid())
  slug        String         @unique
  type        SideMarketType
  title       String
  description String
  isActive    Boolean        @default(true)
  settledAt   DateTime?      @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  options SideMarketOption[]
  picks   SideMarketPick[]

  @@index([type, isActive])
}

model SideMarketOption {
  id                 String   @id @default(cuid())
  marketId           String
  slug               String
  label              String
  rewardChampion     Int?
  rewardQuarterFinal Int?
  rewardSemiFinal    Int?
  lossAmount         Int?
  sortOrder          Int      @default(0)
  metadata           Json?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  market SideMarket       @relation(fields: [marketId], references: [id], onDelete: Cascade)
  picks  SideMarketPick[]

  @@unique([marketId, slug])
  @@index([marketId, isActive, sortOrder])
}

model SideMarketPick {
  id           String                @id @default(cuid())
  userId       String
  marketId     String
  optionId     String
  phase        SideMarketPickPhase
  stakeLoss    Int
  rewardAmount Int
  outcome      SideMarketPickOutcome @default(PENDING)
  settledAt    DateTime?             @db.Timestamptz(3)
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime              @updatedAt @db.Timestamptz(3)

  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  market           SideMarket        @relation(fields: [marketId], references: [id], onDelete: Restrict)
  option           SideMarketOption  @relation(fields: [optionId], references: [id], onDelete: Restrict)
  lossTransactions LossTransaction[]

  @@unique([userId, marketId])
  @@index([marketId, outcome])
  @@index([optionId, outcome])
}

model Payment {
  id            String    @id @default(cuid())
  userId        String
  amount        Int
  paidAt        DateTime  @db.Timestamptz(3)
  note          String?
  confirmedById String
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  voidedAt      DateTime? @db.Timestamptz(3)
  voidedById    String?
  voidReason    String?

  user        User  @relation("PaymentOwner", fields: [userId], references: [id], onDelete: Restrict)
  confirmedBy User  @relation("PaymentConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  voidedBy    User? @relation("PaymentVoider", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([userId, voidedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  actor User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

model ShopItem {
  id          String         @id @default(cuid())
  slug        String         @unique
  type        ShopItemType
  rarity      ShopItemRarity
  name        String
  description String
  priceCtom   Int
  visualKey   String
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  purchases    UserShopItem[]
  equippedBy   UserCosmeticEquip[]
  transactions CtomTransaction[]

  @@index([type, isActive, sortOrder])
}

model UserShopItem {
  id          String   @id @default(cuid())
  userId      String
  itemId      String
  purchasedAt DateTime @default(now()) @db.Timestamptz(3)

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ShopItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([userId, itemId])
  @@index([userId])
  @@index([itemId])
}

model UserCosmeticEquip {
  id         String       @id @default(cuid())
  userId     String
  type       ShopItemType
  itemId     String
  equippedAt DateTime     @default(now()) @db.Timestamptz(3)

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ShopItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([userId, type])
  @@index([userId])
  @@index([itemId])
}

model CtomTransaction {
  id        String              @id @default(cuid())
  userId    String
  itemId    String?
  amount    Int
  type      CtomTransactionType
  note      String?
  createdAt DateTime            @default(now()) @db.Timestamptz(3)

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ShopItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([itemId])
}
